{
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "SIGERSA:"
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=sigersa_db;Username=postgres;Password=CHANGE_ME",
    "DefaultCommandTimeoutSeconds": 30
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT.supabase.co",
    "Key": "CONFIGURE_WITH_USER_SECRETS_OR_ENVIRONMENT",
    "DefaultBucketName": "SIGERSA_FILES",
    "MaxFileSizeBytes": 26214400,
    "AllowedMimeTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "video/mp4"
    ]
  },
  "Reports": {
    "BucketName": "SIGERSA_FILES",
    "BrowserExecutablePath": ""
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "SIGERSA.Api",
      "Audience": "SIGERSA.Pwa",
      "SigningKey": "CONFIGURE_WITH_USER_SECRETS_MINIMUM_32_CHARACTERS",
      "AccessTokenMinutes": 15,
      "ResetTokenMinutes": 10
    },
    "Flow": {
      "MaximumLoginAttempts": 5,
      "LockoutMinutes": 15,
      "OtpLifetimeMinutes": 10,
      "MaximumOtpAttempts": 5,
      "RefreshTokenDays": 14,
      "TwoFactorEnabled": false
    }
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.invalid",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@example.invalid",
    "FromName": "SIGERSA",
    "ApplicationUrl": "http://127.0.0.1:5173/",
    "PasswordRecoveryUrl": "http://127.0.0.1:5173/recuperar-clave.html"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },
  "DataProtection": {
    "KeyRingPath": ".data-protection-keys"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
